# Production Environment Configuration
# Copy this to .env and fill in your actual values

# Database Configuration
DB_USER=genai_user
DB_PASSWORD=your_secure_password_here_change_me
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://genai_user:your_secure_password_here_change_me@postgres:5432/genai_stack

# API Keys (Get from respective services)
GOOGLE_API_KEY=your_google_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here

# ChromaDB Configuration
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
# For production, use: REACT_APP_API_URL=https://your-domain.com

# Application Settings
FASTAPI_ENV=production
LOG_LEVEL=info
PYTHONUNBUFFERED=1

# Nginx/SSL Configuration (if using reverse proxy)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# CORS Settings
ALLOWED_ORIGINS=localhost,your-domain.com

# File Upload Settings
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
UPLOAD_DIRECTORY=./backend/uploaded_files

# Security Settings
SECRET_KEY=your_secret_key_here_change_me
DEBUG=false

# Rate Limiting (requests per minute)
RATE_LIMIT=100
